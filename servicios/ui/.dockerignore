# Reduce el contexto de build de la UI.
#
# node_modules es el motivo principal de este archivo: pesa cientos de megabytes
# y trae binarios compilados para Windows que romperían el build dentro de la
# imagen de Linux.
#
# package.json, package-lock.json, index.html, vite.config.js, src/ y nginx.conf
# NO se excluyen: son justamente lo que hay que construir y servir.

node_modules/
dist/
.vite/

# Entorno local
.env
.env.local
.env.*.local

# Logs de npm
npm-debug.log*
yarn-error.log*

# Editor
.vscode/
.idea/

# No aportan nada a la imagen
Dockerfile
.dockerignore
README.md
