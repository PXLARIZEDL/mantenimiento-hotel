# Reduce el contexto que Docker envía al construir la imagen de ordenes y evita
# que binarios compilados en la máquina local pisen los del contenedor.
#
# El .csproj y los .cs NO se excluyen: son justamente lo que hay que copiar.

# Artefactos de compilación local
bin/
obj/
publish/
TestResults/

# Editor
*.user
*.suo
.vs/
.idea/
.vscode/

# Configuración local que no debe viajar a la imagen
appsettings.Development.json

# Herramientas de desarrollo: el manifiesto de dotnet-ef sirve para generar
# migraciones en la máquina, no para ejecutar el servicio.
.config/

# No aportan nada a la imagen
Dockerfile
.dockerignore
README.md
