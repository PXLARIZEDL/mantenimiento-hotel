{
  "ConnectionStrings": {
    "Postgres": "Host=db-ordenes;Port=5432;Database=ordenes;Username=ordenes;Password=cambiar"
  },

  "Habitaciones": {
    "UrlBase": "http://habitaciones:8080",

    "Resiliencia": {
      "TimeoutSegundos": 3,
      "Reintentos": 3,
      "EsperaBaseMilisegundos": 200,
      "UmbralFallosCircuito": 0.5,
      "SegundosCircuitoAbierto": 30,
      "SegundosVentanaMuestreo": 30,
      "MinimoLlamadasCircuito": 8
    }
  },

  "RabbitMq": {
    "Host": "rabbitmq",
    "Puerto": 5672,
    "Usuario": "guest",
    "Contrasena": "guest",
    "Exchange": "hotel.eventos",
    "ColaOrdenAsignada": "ordenes.orden-asignada",
    "SegundosEsperaReconexion": 5
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

      "Ordenes.Clientes.HabitacionesClient": "Information",
      "Ordenes.Eventos.ConsumidorOrdenAsignada": "Information",
      "Ordenes.Eventos.PublicadorEventos": "Information",
      "Polly": "Information"
    }
  },

  "AllowedHosts": "*",
  "Urls": "http://+:8080"
}
