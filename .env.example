# Plantilla de todas las variables que consume docker-compose.yml.
#
#     cp .env.example .env
#
# .env NO se versiona (lo ignora .gitignore); este archivo SÍ, y sirve además
# como inventario legible de qué se configura en el sistema.
#
# Los valores de aquí son de EJEMPLO y valen para levantar el proyecto en una
# máquina. Nunca poner credenciales reales: este archivo se sube al repo.
#
# Nota sobre la repetición: las cadenas de conexión repiten usuario, contraseña
# y nombre de base. No es un descuido — Docker Compose no expande variables
# dentro del propio .env, así que la cadena tiene que venir escrita completa.
# Si cambiás una contraseña, cambiala en los DOS lugares.

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_USUARIO=guest
RABBITMQ_CONTRASENA=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PUERTO=5672

# Consola web de administración: http://localhost:15672
RABBITMQ_PUERTO_CONSOLA=15672

EXCHANGE=hotel.eventos

# ---------------------------------------------------------------------------
# Bases de datos — una por servicio, nunca compartida
# (docs/adr/002-limites-contextos.md)
# ---------------------------------------------------------------------------
DB_HABITACIONES_USUARIO=habitaciones
DB_HABITACIONES_CONTRASENA=habitaciones_local
DB_HABITACIONES_NOMBRE=habitaciones

DB_ORDENES_USUARIO=ordenes
DB_ORDENES_CONTRASENA=ordenes_local
DB_ORDENES_NOMBRE=ordenes

DB_TECNICOS_USUARIO=tecnicos
DB_TECNICOS_CONTRASENA=tecnicos_local
DB_TECNICOS_NOMBRE=tecnicos

# ---------------------------------------------------------------------------
# Cadenas de conexión
# Los hosts son los NOMBRES de servicio de la red de compose, no localhost.
# ---------------------------------------------------------------------------
CADENA_HABITACIONES=Host=db-habitaciones;Port=5432;Database=habitaciones;Username=habitaciones;Password=habitaciones_local
CADENA_ORDENES=Host=db-ordenes;Port=5432;Database=ordenes;Username=ordenes;Password=ordenes_local

# El servicio Python usa el formato de SQLAlchemy con el driver psycopg 3.
URL_TECNICOS=postgresql+psycopg://tecnicos:tecnicos_local@db-tecnicos:5432/tecnicos

# ---------------------------------------------------------------------------
# La única llamada sincrónica del sistema: ordenes -> habitaciones
# ---------------------------------------------------------------------------
HABITACIONES_URL_BASE=http://habitaciones:8080

# Resiliencia de esa llamada (docs/adr/003-estrategia-comunicacion.md).
# El reintento va POR FUERA del circuit breaker, para que cada intento
# individual alimente su contador.
RESILIENCIA_TIMEOUT_SEGUNDOS=3
RESILIENCIA_REINTENTOS=3
RESILIENCIA_ESPERA_BASE_MS=200
RESILIENCIA_UMBRAL_CIRCUITO=0.5
RESILIENCIA_MINIMO_LLAMADAS=8
RESILIENCIA_VENTANA_SEGUNDOS=30
RESILIENCIA_CIRCUITO_ABIERTO_SEGUNDOS=30

# ---------------------------------------------------------------------------
# Dominio
# ---------------------------------------------------------------------------
# Los eventos viajan en UTC pero los turnos son horarios locales del hotel.
# Sin esto, una falla de las 20:00 locales caería en el turno equivocado.
HOTEL_UTC_OFFSET=-4

# ---------------------------------------------------------------------------
# Puertos publicados hacia el host
# Solo el gateway y la UI son alcanzables desde afuera.
# ---------------------------------------------------------------------------
GATEWAY_PUERTO=8080
UI_PUERTO=5173

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
NIVEL_LOG=Information
