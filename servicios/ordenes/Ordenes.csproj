<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Servicio ordenes — orquestador del caso de uso.
    Es el servicio con más dependencias del sistema: PostgreSQL (datos propios),
    HTTP resiliente hacia habitaciones y RabbitMQ (publica y consume).

    NO se referencia ningún otro .csproj a propósito: compartir ensamblados
    acoplaría los despliegues y rompería docs/adr/002-limites-contextos.md.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ordenes</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Base de datos propia del servicio. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Publica orden.creada y orden.resuelta; consume orden.asignada. -->
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />

    <!--
      Sostiene el requisito de timeout + reintento + circuit breaker de la única
      llamada sincrónica del sistema. Las políticas se arman en Program.cs a
      partir de configuración, nunca aquí ni dentro del cliente.
    -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="8.10.0" />

    <!-- Health checks para GET /salud (PanelSalud de la UI). -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.2" />
    <PackageReference Include="AspNetCore.HealthChecks.Rabbitmq" Version="8.0.1" />

    <!-- Documentación de la API tras el gateway. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

</Project>
